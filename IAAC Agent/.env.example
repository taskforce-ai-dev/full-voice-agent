# ============================================================================
# IAAC Voice Agent (Vidya) — .env template  (SmartPBX-only, INQUIRY-ONLY)
# ----------------------------------------------------------------------------
# This file documents ONLY the variables Vidya actually uses. It is a template:
# copy the KEYS, never the (placeholder) values.
#
# REAL SECRETS DO NOT LIVE HERE. On the production VPS (67.207.90.109) they go
# in /opt/iaac/.env.smartpbx (chmod 600, root-owned), which is git-ignored and
# passed at deploy time via `docker compose --env-file .env.smartpbx ...`. The
# iaac-smartpbx service uses an EXPLICIT environment allowlist in
# docker-compose.yml (there is deliberately NO `env_file:` stanza), so any key
# not listed in that allowlist is ignored even if you set it here.
#
# DELIBERATELY NOT USED (this is an inquiry-only clone of Kavya's Dialog stack,
# with everything transactional dropped by config — do NOT add these back):
#   * NO OpenAI            (no OPENAI_* keys)
#   * NO Twilio            (SmartPBX is the only ingress; no phone number)
#   * NO Yanolja / PMS     (no booking or availability tools)
#   * NO Dialog MCP        (no live human transfer)
#   * NO n8n / handover    (no WhatsApp notify, no post-call webhook)
#   * NO dashboard         (no post-call push)
# With no Yanolja creds, get_tools() returns [] and the model has no booking or
# transfer tool to call — inquiry-only is enforced by config, not just prompt.
# ============================================================================

# === LLM — brain ===========================================================
# Claude is the English brain; Gemini is the Sinhala brain (and Sinhala voice).
# LLM_PROVIDER selects the English/default provider; keep it "claude".
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Gemini powers the Sinhala LLM and the Sinhala TTS voice. Its own key gives
# IAAC an isolated Gemini quota. The bilingual SmartPBX menu is withheld when
# this key is missing/blank, so a caller cannot reach a broken Sinhala path.
# Set the real secret only in /opt/iaac/.env.smartpbx; never commit or print it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Call-local runtime failover from Gemini to Claude on a bounded technical
# failure (never on a replayable tool-executed turn). Does not change LLM_PROVIDER.
GEMINI_FAILOVER_TO_CLAUDE=true
GEMINI_FAILOVER_STICKY_AFTER=2

# === Sinhala pipeline (Direct SmartPBX, press 2) ===========================
# Seconds the bilingual language menu waits for a DTMF selection before
# resolving to English.
SMARTPBX_LANGUAGE_SELECTION_TIMEOUT_SECONDS=8.0
# Sinhala LLM: Gemini by default. Blank resolves to gemini; an invalid nonblank
# value resolves to claude.
SMARTPBX_SINHALA_LLM_PROVIDER=gemini
SMARTPBX_SINHALA_GEMINI_LLM_MODEL=gemini-3.7-flash
SMARTPBX_SINHALA_GEMINI_THINKING_LEVEL=low
SMARTPBX_SINHALA_GEMINI_MAX_TOKENS=1024
# Sinhala VOICE (TTS) = Gemini (uses the same GEMINI_API_KEY above).
SMARTPBX_SINHALA_TTS_PROVIDER=gemini
SMARTPBX_SINHALA_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
SMARTPBX_SINHALA_GEMINI_TTS_VOICE=Vindemiatrix
SMARTPBX_SINHALA_GEMINI_TTS_TIMEOUT_SECONDS=15.0
# Quota-aware TTS model fallback: after this many consecutive quota/rate-limit
# hits a model is skipped (sticky per process) until the daily reset hour.
SMARTPBX_SINHALA_TTS_QUOTA_STICKY_AFTER=3
# Comma-separated fallback TTS models, tried in order only on a classified
# quota/rate-limit error. Blank = no fallbacks.
SMARTPBX_SINHALA_GEMINI_TTS_FALLBACK_MODELS=
# UTC hour (0-23) at which a quota-exhausted TTS model is restored.
SMARTPBX_SINHALA_TTS_MODEL_RESET_UTC_HOUR=7
# Minimum spacing (seconds) between fixed-phrase prewarm renders, to stay under
# Gemini TTS's ~10 req/min cap on a cold start. Clamp [0, 60]; never set 0 in prod.
SMARTPBX_SINHALA_PREWARM_INTERVAL_SECONDS=7.0
# Bind-mounted persistent cache of rendered Sinhala phrase audio (raw mu-law
# bytes, named by a sha256 of (model, voice, text) — never the phrase text).
# Blank disables disk persistence (in-memory only, re-rendered each restart).
SMARTPBX_SINHALA_PHRASE_CACHE_DIR=/app/smartpbx_phrase_cache
# Optional Rime TTS key. Leave blank; not part of the default IAAC stack.
RIME_API_KEY=

# === English voice (TTS) = ElevenLabs ======================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Distinct English voice ID for Vidya. Provision a dedicated voice before going
# live — do NOT reuse another agent's persona voice.
KAVYA_EN_ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID=

# === STT — ears ============================================================
# Azure Speech is the primary STT (forced si-LK for Sinhala; English also on
# Azure). Google STT is available for English via the shared GCP credentials
# file (mounted at /app/gcp-credentials.json — GOOGLE_APPLICATION_CREDENTIALS
# is set in docker-compose.yml, not here).
STT_PROVIDER=azure
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia
# Azure si-LK segmentation silence: 1200 ms avoids committing short thinking
# pauses as premature/duplicate Sinhala turns. 0 = Azure service default.
SMARTPBX_SINHALA_AZURE_SEGMENTATION_SILENCE_MS=1200
SMARTPBX_SINHALA_STT_LOW_CONFIDENCE_THRESHOLD=0.65
# Endpointing timers (seconds), clamped in code. A provider final (Azure) has
# already segmented the utterance, so it flushes after a short grace; the longer
# timer is the fallback for the interim-only path.
STT_ENDPOINTING_SILENCE_SECONDS=1.0
STT_FINAL_GRACE_SECONDS=0.5
# DTMF keypad number capture. Timeouts in seconds; clamped in code.
DTMF_INTERDIGIT_TIMEOUT_SECONDS=6.0
DTMF_OVERALL_TIMEOUT_SECONDS=30.0
DTMF_MAX_DIGITS=15
# Barge-in threshold: only a substantive interruption clears Vidya's audio.
# BARGEIN_MIN_CHARS is the minimum transcript length; BARGEIN_DEBOUNCE_SECONDS
# ignores STT within that window of a sentence starting (her own echo).
BARGEIN_MIN_CHARS=12
BARGEIN_DEBOUNCE_SECONDS=0.6

# === Knowledge base ========================================================
# KB_N_RESULTS=8 from the start (Kavya's retrieval-depth fix): several IAAC
# courses look alike to the embedder, so top-3 would crowd out the specific
# course/fee a caller asks about. KB_DOCS_DIRECTORY is fixed in compose to
# /app/knowledge_docs.
KB_DOCS_DIRECTORY=knowledge_docs
KB_N_RESULTS=8

# === Dialog SmartPBX boundary ==============================================
# ENABLE_SMARTPBX_WSS and SMARTPBX_AUTH_HEADER_NAME are hardcoded in
# docker-compose.yml's allowlist (true / X-IAAC-SmartPBX-Token); shown here for
# reference. The token and account id below MUST be provisioned before go-live.
ENABLE_SMARTPBX_WSS=true
# Shared secret for the media socket + /smartpbx/status auth header.
# generate: openssl rand -hex 32
SMARTPBX_WS_TOKEN=
# Dialog SmartPBX / Client Connect tenant account id (from Dialog).
SMARTPBX_ACCOUNT_ID=
# Auth header the app checks before accepting the WebSocket. Must match the
# nginx vhost and the Dialog client configuration.
SMARTPBX_AUTH_HEADER_NAME=X-IAAC-SmartPBX-Token
# Concurrent-call cap (1-4). Confirm the tenant's capacity with Dialog.
SMARTPBX_MAX_CALLS=4

# Bounded waits and frame limits. The outbound frame queue paces audio at
# realtime, so it must be deep enough to hold a long reply; overflow cuts the
# tail. SMARTPBX_MAX_CALL_SECONDS is a hard per-call ceiling independent of
# idleness. Defaults below match docker-compose.yml.
SMARTPBX_MAX_MESSAGE_CHARS=65536
SMARTPBX_MAX_AUDIO_BYTES=32768
SMARTPBX_MAX_OUTBOUND_FRAMES=512
SMARTPBX_START_TIMEOUT_SECONDS=10
SMARTPBX_IDLE_TIMEOUT_SECONDS=90
SMARTPBX_MAX_CALL_SECONDS=3600
# Inquiry-only: live transfer stays disabled. Empty destinations ({}) mean the
# model can never transfer, and with no Yanolja creds the tool list is empty
# anyway. Left explicit so a default can never silently arm it.
SMARTPBX_TRANSFER_DESTINATIONS_JSON={}
