# === LLM Provider ===
# Options: "claude" (default), "openai", "gemini"
LLM_PROVIDER=claude

# === Claude API ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# === OpenAI API (alternative) ===
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# === Gemini API (alternative) ===
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# === ElevenLabs TTS (production + local test_voice_elevenlabs.py) ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here

# === Azure Speech (Sinhala + Tamil TTS via Media Streams) ===
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia

# === Google Cloud TTS (local testing fallback only) ===
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# === Media Streams STT backend ===
# "google" (default, uses GOOGLE_APPLICATION_CREDENTIALS) or "azure"
# (reuses AZURE_SPEECH_KEY / AZURE_SPEECH_REGION above).
STT_PROVIDER=google
# Capture live Sinhala/Tamil call audio to 8kHz PCM16 wav for offline STT
# benchmarking. Set to 1 to enable; files land in STT_DEBUG_DIR.
STT_DEBUG_DUMP=0
STT_DEBUG_DIR=stt_dumps

# === Twilio (production only) ===
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# === Twilio browser AccessToken (GET /api/voice-token, "Call Now" widget) ===
# Create an API Key/Secret pair and a TwiML App in the Twilio console.
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_TWIML_APP_SID=your_twiml_app_sid

# === English ConversationRelay voice (ElevenLabs flash_v2_5) ===
# Deploy overrides this; default matches the cloned voice.
CR_VOICE_EN=bm3QvaZ3fUSCRBC3UV1f-flash_v2_5

# === n8n Booking API (replaces direct eZee PMS calls) ===
N8N_BASE_URL=https://automation.taskforceai.tech
N8N_POLL_INTERVAL=2
N8N_POLL_TIMEOUT=60

# === Post-Call Data Capture (sends call summary to Google Sheets via n8n) ===
N8N_POSTCALL_WEBHOOK=/webhook/transcript

# Yanolja PMS (replaces legacy KPMS / n8n+browser-extension flow)
# Demo deployment: booking tools are DEMO-SAFE (no real PMS writes), so these
# can be left blank. Set them only to wire a real Yanolja PMS.
YANOLJA_BASE_URL=
YANOLJA_USERNAME=
YANOLJA_PASSWORD=

# === eZee Absolute PMS (legacy — no longer used directly) ===
# EZEE_HOTEL_CODE=your_hotel_code
# EZEE_AUTH_CODE=your_auth_code
# EZEE_API_KEY=your_api_key
# EZEE_BASE_URL=https://live.ipms247.com/booking/reservation_api/listing.php

# === Knowledge Base ===
KB_DOCS_DIRECTORY=knowledge_docs

# === Server ===
PORT=8000
# Public hostname this agent is served from (nginx / Twilio webhooks).
PUBLIC_HOSTNAME=kitchened.taskforceai.tech

# === Demo safety ===
# Booking tools never write to a real PMS in this demo build.
DEMO_SAFE_BOOKINGS=true

# Agent Dashboard (pilot)
DASHBOARD_API_URL=
DASHBOARD_API_KEY=
DASHBOARD_AGENT_ID=kitchened

# Human-agent handoff (English ConversationRelay only). Leave empty to disable.
HUMAN_AGENT_PHONE=
