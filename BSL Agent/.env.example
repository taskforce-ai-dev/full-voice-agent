# =============================================================================
# BSL Voice Agent — environment template
# Copy to .env and fill in your own values. Do NOT commit .env.
# =============================================================================

# === LLM Provider =============================================================
# Options: "claude" (default), "openai", "gemini"
LLM_PROVIDER=claude

# --- Anthropic Claude (default provider) -------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# --- OpenAI (alternative) ----------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# --- Gemini (alternative) ----------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# === ElevenLabs TTS ===========================================================
# ELEVENLABS_API_KEY + ELEVENLABS_VOICE_ID are used by the local
# test_voice_elevenlabs.py smoke-test script.
# ELEVENLABS_CR_VOICE is the voice served to Twilio ConversationRelay
# (format: <voice_id>-<model>, e.g. bm3QvaZ3fUSCRBC3UV1f-flash_v2_5).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here
ELEVENLABS_CR_VOICE=bm3QvaZ3fUSCRBC3UV1f-flash_v2_5

# === Twilio (production telephony) ============================================
# Provided for the BSL demo. TWILIO_PHONE_NUMBER MUST belong to the SID.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# === Post-Call Data Capture ===================================================
# After each call ends, the server posts extracted call data + transcript to
# this n8n webhook. The workflow at the path must be Active in n8n (draft mode
# returns 404).
N8N_BASE_URL=https://automation.taskforceai.tech
N8N_POSTCALL_WEBHOOK=/webhook/bsl-transcript

# === Knowledge Base ===========================================================
# Optional: directory of supplementary text documents indexed into ChromaDB
# on startup. BSL's authoritative customer/account data lives in
# mock_customers.json (consumed via tools), not in the RAG.
KB_DOCS_DIRECTORY=knowledge_docs

# === Server ===================================================================
PORT=8000
