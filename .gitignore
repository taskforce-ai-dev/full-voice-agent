# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/

# Environment files (keep .env.example as a template)
.env
.env.*
!.env.example

# ChromaDB persistence
chroma_db/

# Sentence-transformers model cache
.cache/
sentence-transformers/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Docker volumes
docker-volumes/
*.override.yml

# Audio temp files (PyAudio / TTS)
*.wav
*.mp3
*.pcm
*.raw

# Logs
*.log

# Pytest cache
.pytest_cache/
htmlcov/
.coverage

# Misc
*.bak
*.tmp

# --- Nested repos with their OWN git remotes (do NOT add as broken gitlinks) ---
# These live here for editing convenience but are tracked in their own GitHub repos.
# Committing them from this parent would record broken gitlinks (empty dirs on clone).
# Taskforce_AI_Website/ -> thiva2k/Taskforce_AI_Website (migrated 2026-07-10 off the taskforceai-sl org)
Taskforce_AI_Website/
# agent-dashboard/ -> ChrysFernando/Client-Portal (left as-is)
agent-dashboard/
# NOTE: Kavya/ is part of this monorepo (de-nested). Its own .gitignore + the
# rules below keep its venv/.env/secrets out.

# --- Third-party model download (HuggingFace, ~8 GB — never commit) ---
SinhalaVITS-TTS-M2/

# --- Node / build artifacts ---
node_modules/
.next/
.vercel/

# --- Graphify regenerable cache (keep graph.html / GRAPH_REPORT.md, drop cache) ---
graphify-out/cache/

# --- Claude Code local/personal settings (machine-specific cmds + live tokens) ---
.claude/settings.local.json

# --- Accidental mojibake "C:\Users\mrdar\.claude-mem" dirs claude-mem sprays ---
# (real bytes aren't a literal colon, so match with a glob; capital-C avoids
#  matching the legitimate external .claude-mem store)
C*claude-mem/
**/C*claude-mem/

# --- Secrets / cloud credentials (NEVER commit) ---
# GCP service-account keys (incl. the retired full-voice-agent key, ID a8a245fb...)
full-voice-agent-*.json
gcp-credentials.json
gcp-credentials*.json
*-service-account*.json
*serviceaccount*.json
service-account*.json
# Catch-all for credential drops in any agent dir
**/full-voice-agent-*.json
**/gcp-credentials*.json

# MCP server config -- holds live API tokens in plaintext env blocks (Jul 2026: added
# 5 Hostinger MCP servers here with a raw HOSTINGER_API_TOKEN)
.mcp.json

# n8n workflow exports -- a raw export from the n8n UI carries LIVE credentials
# inline (WasenderAPI bearer, portal ingest key) in every httpRequest node, and
# again inside the duplicated `activeVersion` block. On 2026-08-04 an unignored
# export was sitting in the working tree with a live WasenderAPI token in eight
# places, one `git add .` away from being committed.
#
# So: ignore every export by DEFAULT and opt curated snapshots back in, rather
# than the reverse. A new export is then untracked until someone has scrubbed it
# and un-ignored it deliberately. Scrub with the placeholder convention already
# used below, e.g. `Bearer <WASENDER_TOKEN — see n8n UI>`.
n8n-workflows/*.json
!n8n-workflows/treehouse-post-call-processor.json
!n8n-workflows/kavya-handover-whatsapp.json
