# =============================================================================
# Horizon Airline & Aviation Academy Voice Agent (Vidya) — .env template
# =============================================================================
# De-identified aviation-college INQUIRY-ONLY demo.
#
# Real secrets live in /opt/horizon/.env on the VPS — NEVER commit real values.
# This is an inquiry-only demo: NO PMS / booking integration, NO Google STT.
# Booking/PMS code is present but inert; tools are OFF by construction (see
# HORIZON_ENABLE_BOOKING_TOOLS below) and post-call egress is fail-closed
# (DEMO_SAFE_BOOKINGS below).
#
# LANGUAGE STACK — four demo languages (mirrors Kavya's Dialog line where one
# exists; a website demo is a Twilio browser call, so transport is Twilio):
#   English  -> Claude brain + ElevenLabs voice        (ConversationRelay)
#   Russian  -> Claude brain + ElevenLabs voice, ru-RU (ConversationRelay)
#   Arabic   -> Claude brain + ElevenLabs voice + Azure STT ar-SA (Media Streams)
#   Sinhala  -> Gemini brain + Gemini TTS voice + Azure STT si-LK (Media Streams)
#
# Copy to .env and fill in real values for local runs.
# =============================================================================

# --- LLM: Anthropic Claude (English/Russian/Arabic brain) ---------------------
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- English / Russian voice: ElevenLabs (Twilio ConversationRelay) ----------
ELEVENLABS_API_KEY=...
# English ConversationRelay voice id (with the -flash_v2_5 suffix).
CR_VOICE_EN=bm3QvaZ3fUSCRBC3UV1f-flash_v2_5
# Russian ConversationRelay voice id (ru-RU). Optional; has a built-in default.
CR_VOICE_RU=YjESejviApN7SHrbfnA2-flash_v2_5
# ElevenLabs voice id used on the Media Streams path (Arabic / fallback / non-CR).
ELEVENLABS_VOICE_ID=...
# Dedicated Arabic ElevenLabs voice for the Media Streams path. Optional; falls
# back to ELEVENLABS_VOICE_ID when unset.
ELEVENLABS_VOICE_ID_AR=tavIIPLplRB883FzWU0V

# --- Inquiry-only + egress safety (leave unset for the demo) ------------------
# Booking tools are OFF by construction in tools.py — there is NO env var that
# turns them on (an inherited PMS key cannot expose them). Nothing to set here.
#
# Post-call egress (LLM extraction + n8n + dashboard, incl. call-started
# metadata) is FAIL-CLOSED: it ships NOTHING unless HORIZON_POST_CALL_EGRESS is
# set to EXACTLY "enabled". Any other value (false/0/typo/unset) = no egress.
# Leave it unset for the demo.
# HORIZON_POST_CALL_EGRESS=enabled

# --- WebSocket ingress auth ---------------------------------------------------
# /ws/* requires a short-lived HMAC ticket minted into the TwiML wss URL. The
# signing secret defaults to TWILIO_AUTH_TOKEN (already set above); override
# only if you want a dedicated secret. If neither is set, WS auth is disabled
# (local dev only).
# WS_TICKET_SECRET=
# WS_TICKET_TTL_SECONDS=300

# --- Sinhala brain + voice: Gemini (Kavya Dialog stack) ----------------------
# REQUIRED for Sinhala. Without it, Sinhala falls back to the Claude brain and
# OpenAI TTS voice (see below), and the call still works.
GEMINI_API_KEY=...
# Sinhala LLM (brain). Set SI_LLM_PROVIDER=claude to disable the Gemini brain.
SI_LLM_PROVIDER=gemini
SI_GEMINI_MODEL=gemini-3.7-flash
# Sinhala voice = Gemini TTS. NOTE: this preview model has a ~100 requests/day
# cap; a busy public demo day can exhaust it (then Sinhala falls back to OpenAI).
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Vindemiatrix
GEMINI_TTS_TIMEOUT_SECONDS=30

# --- Sinhala voice fallback: OpenAI TTS (only if Gemini TTS unavailable) ------
OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=sage
# Sinhala TTS persona/voice-direction for gpt-4o-mini-tts (fallback path).
OPENAI_TTS_INSTRUCTIONS=You are Vidya, a warm and professional course advisor at Horizon Airline & Aviation Academy, an aviation training academy in Sri Lanka. Speak natural, courteous conversational Sinhala with genuine warmth. Vary pitch and pace naturally and sound like a real person on the phone, not a robot.

# --- Sinhala ears: Azure Speech STT (si-LK) ----------------------------------
STT_PROVIDER=azure
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=southeastasia

# --- Telephony: Twilio -------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# --- Knowledge base hot-reload secret ----------------------------------------
# Shared secret guarding the POST /kb-reload endpoint used by the admin portal.
KB_RELOAD_SECRET=...
