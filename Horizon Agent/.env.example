# =============================================================================
# Horizon Airline & Aviation Academy Voice Agent (Vidya) — .env template
# =============================================================================
# De-identified aviation-college INQUIRY-ONLY demo. English + Sinhala only.
#
# Real secrets live in /opt/horizon/.env on the VPS — NEVER commit real values.
# This file documents ONLY the keys this en+si inquiry demo actually uses.
# This is an inquiry-only demo: NO PMS / booking integration, NO Gemini,
# NO Google STT. Booking/PMS code is present but inert (no creds configured).
#
# Copy to .env and fill in real values for local runs.
# =============================================================================

# --- LLM: Anthropic Claude (both English and Sinhala brains) ------------------
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- English voice: ElevenLabs (Twilio ConversationRelay) --------------------
ELEVENLABS_API_KEY=...
# English ConversationRelay voice id (with the -flash_v2_5 suffix).
CR_VOICE_EN=bm3QvaZ3fUSCRBC3UV1f-flash_v2_5
# ElevenLabs voice id used on the Media Streams path (fallback / non-CR).
ELEVENLABS_VOICE_ID=...

# --- Sinhala voice: OpenAI TTS (Media Streams) -------------------------------
OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=sage
# Sinhala TTS persona/voice-direction for gpt-4o-mini-tts.
OPENAI_TTS_INSTRUCTIONS=You are Vidya, a warm and professional course advisor at Horizon Airline & Aviation Academy, an aviation training academy in Sri Lanka. Speak natural, courteous conversational Sinhala with genuine warmth. Vary pitch and pace naturally and sound like a real person on the phone, not a robot.

# --- Sinhala ears: Azure Speech STT (si-LK) ----------------------------------
STT_PROVIDER=azure
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=southeastasia

# --- Telephony: Twilio -------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# --- Knowledge base hot-reload secret ----------------------------------------
# Shared secret guarding the POST /kb-reload endpoint used by the admin portal.
KB_RELOAD_SECRET=...
