# === LLM Provider ===
# Options: "claude" (default), "openai", "gemini"
LLM_PROVIDER=claude

# === Claude API ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# === OpenAI API (alternative) ===
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# === Gemini API (alternative) ===
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# === ElevenLabs TTS (production + local test_voice_elevenlabs.py) ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here
# Dedicated Arabic voice (Media Streams). Defaults to tavIIPLplRB883FzWU0V if unset.
ELEVENLABS_VOICE_ID_AR=tavIIPLplRB883FzWU0V

# === Azure Speech (Sinhala + Tamil TTS via Media Streams) ===
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia

# === Google Cloud TTS (local testing fallback only) ===
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# === Media Streams STT backend ===
# "google" (default, uses GOOGLE_APPLICATION_CREDENTIALS) or "azure"
# (reuses AZURE_SPEECH_KEY / AZURE_SPEECH_REGION above).
STT_PROVIDER=google
# Capture live Sinhala/Tamil call audio to 8kHz PCM16 wav for offline STT
# benchmarking. Set to 1 to enable; files land in STT_DEBUG_DIR.
STT_DEBUG_DUMP=0
STT_DEBUG_DIR=stt_dumps

# === IVR / DTMF language menu ===
# "true" presents the language menu on incoming calls. The line is English-only
# (Sinhala/Arabic removed 2026-07-28), so the menu now has a single option.
# Default "false": every call connects straight to the English agent.
IVR_MENU_ENABLED=false

# === Demo rates ===
# "true" (default) lets Kavya quote the INVENTED Hatton Hills rate card in
# yanolja_service.DEMO_NIGHTLY_RATE_USD (USD 700-1400 per room per night, half
# board), and surfaces rate_per_night_usd / total_usd in tool results.
# Hatton Hills is itself an invented demo property — none of this is a real rate
# card. Set "false" to fall back to "we publish no rates, reservations will
# confirm" behaviour — the prompt, the KB wording and the tool results all
# follow this flag. Changing it needs a container recreate, not just a restart.
# Keep in sync with room_types.base_price in the PMS
# (ops/hattonhills-pms/rename_to_hattonhills.sql) or the folio total won't match
# the quote.
DEMO_RATES_ENABLED=true

# === Twilio (production only) ===
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# === n8n Booking API (replaces direct eZee PMS calls) ===
N8N_BASE_URL=https://automation.taskforceai.tech
N8N_POLL_INTERVAL=2
N8N_POLL_TIMEOUT=60

# === Post-Call Data Capture (sends call summary to Google Sheets via n8n) ===
N8N_POSTCALL_WEBHOOK=/webhook/transcript

# Yanolja PMS (replaces legacy KPMS / n8n+browser-extension flow)
YANOLJA_BASE_URL=https://yanolja.taskforceai.tech/api
YANOLJA_USERNAME=admin
YANOLJA_PASSWORD=admin123

# === eZee Absolute PMS (legacy — no longer used directly) ===
# EZEE_HOTEL_CODE=your_hotel_code
# EZEE_AUTH_CODE=your_auth_code
# EZEE_API_KEY=your_api_key
# EZEE_BASE_URL=https://live.ipms247.com/booking/reservation_api/listing.php

# === Knowledge Base ===
KB_DOCS_DIRECTORY=knowledge_docs

# === Server ===
PORT=8000

# Agent Dashboard (pilot)
DASHBOARD_API_URL=
DASHBOARD_API_KEY=
DASHBOARD_AGENT_ID=kavya

# Human-agent handoff (English ConversationRelay only). Leave empty to disable.
HUMAN_AGENT_PHONE=

# Caller ID for the outbound transfer leg. SET THIS to a number the Twilio
# account OWNS — the number guests dial is the natural choice.
#
# Leaving it empty makes Twilio pass the GUEST's number through as caller ID.
# On Sri Lankan mobile destinations the local carrier sees an international leg
# claiming a local number, treats it as CLI spoofing, and either never rings the
# handset or answers instantly with a recorded intercept. Both shapes have
# happened in production (2026-07-31 and 2026-08-03); the second one also
# reports DialCallStatus=completed, so the transfer silently looks successful.
TWILIO_CALLER_ID=

# Seconds the transfer leg rings before giving up and running the WhatsApp
# failsafe. Twilio allows up to 600.
HANDOFF_DIAL_TIMEOUT=40

# A dial answered faster than this many seconds is treated as a carrier
# intercept rather than a human pickup, so the failsafe still fires. Raise only
# if a legitimate destination genuinely answers sub-second.
HANDOFF_MIN_ANSWER_SECONDS=2.0
