# === LLM Provider ===
# Options: "claude" (default), "openai", "gemini"
LLM_PROVIDER=claude

# === Claude API ===
# This value is the TWILIO path's pinned snapshot (see
# tests/test_llm_default_model.py — the previous default was retired and 404s).
# The Dialog SmartPBX canary and prod do NOT run it: /opt/kavya/.env.smartpbx
# sets CLAUDE_MODEL=claude-sonnet-5, whose adaptive thinking is ON by default
# and kept deliberately. That thinking is spent out of the same output budget
# as the tool block, which is why the SmartPBX path runs its own
# SMARTPBX_CLAUDE_MAX_TOKENS=600 rather than the shared 120. See
# SMARTPBX_RUNBOOK.md § "Claude direct SmartPBX output budget".
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# === OpenAI API (alternative) ===
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# === Gemini API (alternative) ===
# Required by the SmartPBX Sinhala Gemini LLM and TTS paths. The bilingual
# SmartPBX menu validates it before emitting either language segment. Set the
# secret only in protected server-side .env.smartpbx; never commit or print it.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Gemini "thinking" is ON by default and its tokens are charged against the
# 300-token voice output budget. Left on, it produced 2.5-5.3s of dead air
# before the first spoken word and turns that returned NOTHING at all (the
# thinking budget ate the whole allowance). A voice turn is one or two short
# sentences, so it is disabled by default. 2.x models take a token budget
# (0 = off); 3.x models cannot disable it and take a level instead
# ("low" | "medium" | "high").
# GEMINI_THINKING_BUDGET=0
# GEMINI_THINKING_LEVEL=low
# Runtime failover from Gemini to Claude on a bounded technical failure
# (never on a replayable tool-executed turn). Call-local; does not change
# LLM_PROVIDER. In the kavya-smartpbx allowlist with these same defaults.
GEMINI_FAILOVER_TO_CLAUDE=true
GEMINI_FAILOVER_STICKY_AFTER=2

# === ElevenLabs TTS (production + local test_voice_elevenlabs.py) ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
KAVYA_EN_ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here
# Dedicated Arabic voice (Media Streams). Defaults to tavIIPLplRB883FzWU0V if unset.
ELEVENLABS_VOICE_ID_AR=tavIIPLplRB883FzWU0V
# First-frame latency optimisation (0-4). 3 is the useful ceiling for
# conversational telephony; 4 also disables text normalisation, which mangles
# the spoken numbers and prices this agent reads out. 0 omits the parameter.
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=3

# === Azure Speech (Sinhala + Tamil TTS via Media Streams) ===
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia

# === Google Cloud TTS (local testing fallback only) ===
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# === Media Streams STT backend ===
# "google" (default, uses GOOGLE_APPLICATION_CREDENTIALS) or "azure"
# (reuses AZURE_SPEECH_KEY / AZURE_SPEECH_REGION above).
STT_PROVIDER=google
# English Google STT digit-sequence OOV class. Leave blank to retain the
# source default (4.0); `0` disables only this class, not the phrase list.
# Choose any nonzero production value only through the later reviewed SmartPBX
# runbook procedure -- no production value belongs in this template.
STT_DIGIT_CLASS_BOOST=
# Capture live Sinhala/Tamil call audio to 8kHz PCM16 wav for offline STT
# benchmarking. Set to 1 to enable; files land in STT_DEBUG_DIR.
STT_DEBUG_DUMP=0
STT_DEBUG_DIR=stt_dumps
# Break-glass visibility for controlled SmartPBX pilot calls only. The default
# keeps all transcript text out of operational logs; never enable for customer
# traffic or leave enabled after a diagnostic call.
SMARTPBX_PILOT_TRANSCRIPT_LOGGING=0
# Endpointing timers (seconds), clamped in code. A provider final (Azure) has
# already segmented the utterance, so it flushes after a short grace; the longer
# timer is the fallback for the interim-only path where no final ever fires.
STT_ENDPOINTING_SILENCE_SECONDS=1.0
STT_FINAL_GRACE_SECONDS=0.5
CAPTURE_ENDPOINTING_SILENCE_SECONDS=1.5
CAPTURE_FINAL_GRACE_SECONDS=1.2
# Direct SmartPBX phone capture only: a complete Sri Lankan mobile final uses
# this short grace instead of the patient capture window.
CAPTURE_VALID_LK_NUMBER_GRACE_SECONDS=0.35
# DTMF keypad number capture (SmartPBX). Keypad entry bypasses STT and is
# exact, used for phone/WhatsApp/callback numbers. Timeouts in seconds, clamped.
DTMF_INTERDIGIT_TIMEOUT_SECONDS=6
DTMF_OVERALL_TIMEOUT_SECONDS=30
DTMF_MAX_DIGITS=15
# Barge-in threshold: only a substantive interruption clears Kavya's audio.
# BARGEIN_MIN_CHARS is the minimum transcript length; BARGEIN_DEBOUNCE_SECONDS
# ignores STT within that window of a sentence starting (her own echo).
BARGEIN_MIN_CHARS=12
BARGEIN_DEBOUNCE_SECONDS=0.6
# Twilio Media Streams (Google STT) only -- NOT in the kavya-smartpbx compose
# allowlist, so setting these in .env.smartpbx has no effect there. Google
# terminates ONE streaming_recognize at 305 SECONDS OF AUDIO with a 400.
# The stream is therefore rotated proactively: past STT_STREAM_ROTATE_SECONDS it
# waits for STT_ROTATE_QUIET_SECONDS of caller silence so the swap cannot clip a
# word, and past the DEADLINE it rotates regardless. Do NOT raise the deadline
# to 305 or beyond: hitting the ceiling is what left a live call deaf for 3.5
# minutes on 2026-08-11.
STT_STREAM_ROTATE_SECONDS=240
STT_STREAM_ROTATE_DEADLINE_SECONDS=285
STT_ROTATE_QUIET_SECONDS=0.3
# Twilio-only (see note above). Audio buffered across a stream swap and
# replayed into the replacement, in Twilio 20ms mulaw frames (500 = ~10s).
# Older frames are dropped first.
STT_SWAP_BUFFER_CHUNKS=500
# Twilio-only (see note above). Google narrowband recognition, ENGLISH ONLY
# (si/ta/ar keep the default model because telephony-model coverage for them
# is unverified). Blank the model to disable; a rejection by the API degrades
# to the default model automatically.
STT_GOOGLE_MODEL_EN=telephony
# Twilio-only (see note above). Speech-adaptation boost applied to the
# English booking phrase list (0-20).
STT_ADAPTATION_BOOST=15

# Twilio Media Streams only -- NOT in the kavya-smartpbx compose allowlist.
# ECHO_MATCH_MIN_RATIO is the minimum transcript-overlap ratio used to
# suppress the agent's own TTS bleeding back into STT.
# ECHO_SUPPRESSION_ENABLED=true
# ECHO_MATCH_MIN_RATIO=0.6

# Twilio Media Streams only -- NOT in the kavya-smartpbx compose allowlist.
# Spoken-number dictation capture bounds (see "Spoken-number capture
# contract" in CLAUDE.md).
# CAPTURE_MODE_MAX_TURNS=3
# CAPTURE_BUFFER_MAX_CHARS=600
# CAPTURE_DICTATION_MIN_RATIO=0.3

# === IVR / DTMF language menu ===
# "true" presents the language menu on incoming calls. The line is English-only
# (Sinhala/Arabic removed 2026-07-28), so the menu now has a single option.
# Default "false": every call connects straight to the English agent.
IVR_MENU_ENABLED=false

# === Demo rates ===
# "true" (default) lets Kavya quote the INVENTED Hatton Hills rate card in
# yanolja_service.DEMO_NIGHTLY_RATE_USD (USD 700-1400 per room per night, half
# board), and surfaces rate_per_night_usd / total_usd in tool results.
# Hatton Hills is itself an invented demo property — none of this is a real rate
# card. Set "false" to fall back to "we publish no rates, reservations will
# confirm" behaviour — the prompt, the KB wording and the tool results all
# follow this flag. Changing it needs a container recreate, not just a restart.
# Keep in sync with room_types.base_price in the PMS
# (ops/hattonhills-pms/rename_to_hattonhills.sql) or the folio total won't match
# the quote.
DEMO_RATES_ENABLED=true

# === Twilio (production only) ===
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# === n8n Booking API (replaces direct eZee PMS calls) ===
N8N_BASE_URL=https://automation.taskforceai.tech
N8N_POLL_INTERVAL=2
N8N_POLL_TIMEOUT=60

# === Post-Call Data Capture (sends call summary to Google Sheets via n8n) ===
# Default matches the code default (post_call.py) and the SmartPBX runbook
# template. Do not set this to /webhook/transcript -- that path does not exist
# in the current n8n workflow and cutover gate 3 will fail confusingly.
N8N_POSTCALL_WEBHOOK=/webhook/post-call-data

# Yanolja PMS (replaces legacy KPMS / n8n+browser-extension flow)
YANOLJA_BASE_URL=https://yanolja.taskforceai.tech/api
YANOLJA_USERNAME=
YANOLJA_PASSWORD=
# HTTP client timeout in seconds (yanolja_client.py). Required in the SmartPBX
# compose allowlist -- an omitted line here crash-loops kavya-smartpbx.
YANOLJA_TIMEOUT=30

# === eZee Absolute PMS (legacy — no longer used directly) ===
# EZEE_HOTEL_CODE=your_hotel_code
# EZEE_AUTH_CODE=your_auth_code
# EZEE_API_KEY=your_api_key
# EZEE_BASE_URL=https://live.ipms247.com/booking/reservation_api/listing.php

# === Knowledge Base ===
KB_DOCS_DIRECTORY=knowledge_docs

# === Server ===
PORT=8000

# === Error tracking (Sentry) — no-op unless SENTRY_DSN is set ===
# Required in the SmartPBX compose allowlist -- an omitted
# SENTRY_TRACES_SAMPLE_RATE line crash-loops kavya-smartpbx whenever
# SENTRY_DSN is set (float("") raises at import).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENV=production

# Agent Dashboard (pilot)
DASHBOARD_API_URL=
DASHBOARD_API_KEY=
DASHBOARD_AGENT_ID=kavya

# Human-agent handoff (English ConversationRelay only). Leave empty to disable.
#
# SETTLED 2026-08-05: production dials a Dialog (07x) number. It was moved off
# the previous SLT-Mobitel 071 line, which sits on an international termination
# route that intermittently answers with a carrier intercept instead of ringing
# the handset — three consecutive transfers were intercepted on 2026-08-05
# before the switch, and none since. That handset ALSO diverted to voicemail
# after 20s of ringing, which no detection logic can catch (see
# HANDOFF_DIAL_TIMEOUT below).
#
# This is a DECISION, not a demo-day workaround. If you move this number, pick
# one whose network is not SLT-Mobitel and confirm it either has no voicemail
# or diverts LATER than HANDOFF_DIAL_TIMEOUT, then re-test an unanswered
# transfer end to end and confirm the manager's WhatsApp actually arrives.
HUMAN_AGENT_PHONE=

# Caller ID for the outbound transfer leg. SET THIS to a number the Twilio
# account OWNS — the number guests dial is the natural choice.
#
# Leaving it empty makes Twilio pass the GUEST's number through as caller ID,
# which is never what you want on an international leg.
#
# NOTE (corrected 2026-08-05): an earlier version of this comment blamed the
# carrier intercepts on presenting a US caller ID to a Sri Lankan mobile.
# Twilio's own call records disprove that — a leg on 2026-08-03 10:09 was
# intercepted while presenting a SRI LANKAN caller ID, and three legs on the US
# number rang normally. Setting this correctly is still right, but it is not the
# cure for intercepts. See HANDOFF_DIAL_TIMEOUT below and Kavya/CLAUDE.md v0.21.
TWILIO_CALLER_ID=

# Seconds the transfer leg rings before giving up and running the WhatsApp
# failsafe. Twilio allows up to 600.
#
# THIS VALUE IS A TRADE-OFF IN BOTH DIRECTIONS — do not "just raise it":
#
#   too LOW  -> cuts off a genuine slow answer and bounces the guest into the
#               failsafe when a human was about to pick up.
#   too HIGH -> the destination's VOICEMAIL answers first. Voicemail rings
#               first and answers slowly, so it is INDISTINGUISHABLE from a
#               human by timing — _answer_looks_intercepted cannot catch it,
#               the failsafe never fires, and the guest hears the voicemail
#               greeting. Twilio's AMD would separate them but is not available
#               on <Dial><Number>.
#
# Measured on the production route (2026-08-05): international post-dial delay
# is 11-13s BEFORE ringing even starts, genuine human answers landed at 18.6s /
# 19.7s / 20.65s from dial, and one handset diverted to voicemail at exactly 20s
# of ringing (31s from dial).
#
# SETTLED at 25 on 2026-08-05 by the repo owner, after the value was reviewed
# with those measurements in hand. It beats the voicemail divert while leaving
# roughly 12s of real ringing for a human. This is a DECISION, not a leftover
# demo-day workaround — do not "restore" it to 40. Raising it hands unanswered
# transfers to voicemail, and because voicemail is undetectable, the failsafe
# then never fires and the lead is lost silently. That is the failure this
# value exists to prevent.
#
# The margin is genuinely tight (the 20.65s answer had 4.3s to spare) and that
# is understood and accepted. If genuine answers start getting cut off, the fix
# is a destination that rings faster or a better route -- not a higher number.
HANDOFF_DIAL_TIMEOUT=25

# A dial answered faster than this many seconds is treated as a carrier
# intercept rather than a human pickup, so the failsafe still fires. Raise only
# if a legitimate destination genuinely answers sub-second.
#
# Note this catches only the INSTANT-answer shape (intercept, unconditional
# divert). It cannot catch voicemail — see HANDOFF_DIAL_TIMEOUT above.
HANDOFF_MIN_ANSWER_SECONDS=2.0

# Hang up a leg the moment it is identified as a carrier intercept, instead of
# leaving the guest bridged to the recording. answerOnBridge bridges them the
# instant the leg is "answered", so without this an intercept plays at the guest
# for as long as the carrier talks — 49s and 52s in the production incidents —
# and only then does <Dial> return and the failsafe get its turn, by which point
# the guest has hung up.
#
# The trigger is deliberately STRICTER than HANDOFF_MIN_ANSWER_SECONDS alone: it
# also requires that NO ringing event arrived. This cuts off a LIVE call rather
# than reclassifying a finished one, and a genuine handset essentially always
# rings first.
#
# Set to "false" (or 0/no/off) to disable at runtime without a code deploy.
HANDOFF_KILL_INTERCEPT=true

# === Dialog SmartPBX (isolated profile; disabled by default) ===
# The kavya-smartpbx Compose profile sets KAVYA_SERVICE_MODE=smartpbx and enables
# this boundary only in its container. Do not enable this on the Twilio service.
ENABLE_SMARTPBX_WSS=false
SMARTPBX_WS_TOKEN=
SMARTPBX_ACCOUNT_ID=
SMARTPBX_AUTH_HEADER_NAME=X-Kavya-SmartPBX-Token
SMARTPBX_MAX_CALLS=4

# Bounded waits. The outbound frame queue paces audio at realtime, so it must
# be deep enough to hold a long reply (512 frames is about 40s, ~320KB/call);
# overflow cuts the tail of the reply. An acknowledged transfer waits past
# ordinary idleness for its carrier terminal event, but not forever -- if
# Dialog never sends one, this ceiling releases the capacity slot.
SMARTPBX_MAX_MESSAGE_CHARS=65536
SMARTPBX_MAX_AUDIO_BYTES=32768
SMARTPBX_MAX_OUTBOUND_FRAMES=512
# One-time decoder/jitter-buffer startup canary. Default off; values must be
# 20 ms multiples in [0, 2000]. This does not change media codec or sample rate.
SMARTPBX_STARTUP_PREROLL_MS=0
SMARTPBX_MAX_TOKENS=
# Claude-only direct-SmartPBX English/Sinhala output budget (default 600,
# clamped 200-1024).
# Claude runs adaptive thinking by default, so a tool-calling turn spends
# output tokens before the tool block opens; the shared SMARTPBX_MAX_TOKENS
# budget truncated those blocks mid-JSON. Leave blank to take the default.
# OpenAI and Gemini stay on SMARTPBX_MAX_TOKENS.
SMARTPBX_CLAUDE_MAX_TOKENS=
# Direct SmartPBX Sinhala only: adaptive thinking stays enabled while this
# setting selects its effort. `medium` is the latency default; set `high` to
# roll back to the prior depth. Blank/whitespace takes the `medium` default;
# any nonblank invalid value fails closed to `high`.
SMARTPBX_SINHALA_CLAUDE_EFFORT=
# Direct SmartPBX English only: delay before the neutral initial filler
# ('Just a moment while I check that for you.') plays on round 0 of a turn.
# Default 1.5, clamped [0.5, 5.0]. Direct Sinhala uses its own
# SMARTPBX_SINHALA_INITIAL_FILLER_DELAY_SECONDS below instead.
SMARTPBX_INITIAL_FILLER_DELAY_SECONDS=
# Direct SmartPBX Sinhala only (2026-09-04 tester feedback): Gemini's first
# token is typically 1.2-1.5s (3.9s when throttled), and the shared English
# 1.5s delay above fired the Sinhala filler on most turns even when the
# answer was only moments away. Default 2.2, clamped [0.5, 5.0] -- higher so
# the filler is reserved for genuinely slow turns. The filler also never
# repeats on two consecutive turns within 15s unless this delay itself
# exceeds 3.5s (not env-tunable -- a fixed per-session guard).
SMARTPBX_SINHALA_INITIAL_FILLER_DELAY_SECONDS=

# SmartPBX callers choose 1 for English or 2 for Sinhala. This direct SmartPBX
# menu is bilingual and validates the Gemini key before it starts; it times out
# to English. These four settings apply only to the SmartPBX Sinhala LLM.
SMARTPBX_LANGUAGE_SELECTION_TIMEOUT_SECONDS=8.0
SMARTPBX_SINHALA_LLM_PROVIDER=gemini
SMARTPBX_SINHALA_GEMINI_LLM_MODEL=gemini-3.7-flash
SMARTPBX_SINHALA_GEMINI_THINKING_LEVEL=low
SMARTPBX_SINHALA_GEMINI_MAX_TOKENS=1024
SMARTPBX_SINHALA_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
SMARTPBX_SINHALA_GEMINI_TTS_VOICE=Vindemiatrix
SMARTPBX_SINHALA_GEMINI_TTS_TIMEOUT_SECONDS=15.0
SMARTPBX_SINHALA_TTS_QUOTA_STICKY_AFTER=3
SMARTPBX_SINHALA_GEMINI_TTS_FALLBACK_MODELS=
SMARTPBX_SINHALA_TTS_MODEL_RESET_UTC_HOUR=7
# 2026-09-04 (rate-limit incident): the Sinhala fixed-phrase prewarm used to
# fire all ~19 phrases back-to-back on every container start, tripping
# Gemini TTS's ~10 requests/minute cap (the failed phrases) and spending
# ~19% of the 100 requests/day cap on every restart. Default 7.0 keeps a
# cold start under ~9 requests/minute; clamped [0, 60] -- 0 disables pacing
# (test/local use only, never set it to 0 in production).
SMARTPBX_SINHALA_PREWARM_INTERVAL_SECONDS=7.0
# Bind-mounted directory for the persistent rendered-phrase cache (see
# docker-compose.yml's kavya-smartpbx volumes and SMARTPBX_RUNBOOK.md). Every
# file under it is raw mu-law audio bytes named by a sha256 hash of
# (model, voice, text) -- never the phrase text. Blank disables disk
# persistence (in-memory only, re-rendered on every restart, the pre-2026-09
# behaviour). Deleting the directory just costs one re-render per phrase.
SMARTPBX_SINHALA_PHRASE_CACHE_DIR=/app/smartpbx_phrase_cache

# Direct SmartPBX English provider timing (Phase B reliability policy). Only
# applies to the direct SmartPBX call path -- Twilio Media Streams (ar/si/ta)
# is unaffected. SMARTPBX_LLM_INITIAL_RESPONSE_TIMEOUT_SECONDS bounds how long
# a provider round may go with zero content/tool deltas before Kavya recovers
# with a spoken line and keeps the call open; SMARTPBX_LLM_STALL_TIMEOUT_SECONDS
# bounds the gap between successive deltas once streaming has started. There is
# no total stream deadline while content keeps arriving. Both default to 8.0s,
# clamp [1.0, 30.0]. Claude-only adaptive-thinking grace defaults to 12.0s on
# the first attempt only after a verified thinking block; metadata, text, tool,
# retries, OpenAI, and Gemini keep the shared stall timeout. It clamps [1.0,
# 30.0] and is floored by the shared timeout; set it to 8.0 to restore the
# previous timing.
SMARTPBX_LLM_INITIAL_RESPONSE_TIMEOUT_SECONDS=
SMARTPBX_LLM_STALL_TIMEOUT_SECONDS=
SMARTPBX_CLAUDE_THINKING_STALL_TIMEOUT_SECONDS=
SMARTPBX_START_TIMEOUT_SECONDS=10
SMARTPBX_IDLE_TIMEOUT_SECONDS=90
SMARTPBX_TRANSFER_PENDING_TIMEOUT_SECONDS=300
# Hard per-call ceiling, independent of idleness/transfer-pending activity --
# unlike those two, it does not reset on inbound media. Default 3600s (1h),
# clamp [300, 7200]. Closes the call with code 1000 (a polite, expected close,
# not a policy violation) and diagnostic failure_class=max_call_duration.
SMARTPBX_MAX_CALL_SECONDS=3600

# Dialog sends g711_ulaw audio at 8000 Hz. These are dashboard media settings,
# not application secrets, and must match the Dialog client configuration.
SMARTPBX_MEDIA_ENCODING=g711_ulaw
SMARTPBX_MEDIA_SAMPLE_RATE=8000

# SmartPBX handover notification stays server-side and is distinct from the
# Twilio-only HUMAN_AGENT_PHONE. Leave empty until Dialog confirms the path.
SMARTPBX_HUMAN_AGENT_WHATSAPP=

# Dialog MCP call control remains disabled until every value below is supplied
# on the server. Dialog supports exactly one account header spelling per call:
# account_id or X-Account-ID. Confirm the vendor's spelling during credentialed
# preflight, select exactly one, and never send both; this example guesses none.
SMARTPBX_MCP_URL=https://dialog.cybergate.lk:9443/ucp/v2/mcp
SMARTPBX_API_KEY=
SMARTPBX_MCP_ACCOUNT_HEADER=
SMARTPBX_TRANSFER_DESTINATIONS_JSON={}
# Bounded MCP call-control limits (smartpbx_mcp.py). Required in the SmartPBX
# compose allowlist -- an omitted line here fails "invalid_limits" and
# silently disables transfer even when the URL/key/destinations are valid.
SMARTPBX_MCP_CONNECT_TIMEOUT_SECONDS=5
SMARTPBX_MCP_READ_TIMEOUT_SECONDS=15
SMARTPBX_MCP_MAX_RESPONSE_BYTES=1048576
SMARTPBX_MCP_RETRIES=1
