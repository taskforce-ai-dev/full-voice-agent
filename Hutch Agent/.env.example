# === LLM Provider ===
# Options: "claude" (default), "openai", "gemini"
# NOTE: the notify_human_handover tool is only wired for LLM_PROVIDER=claude.
# OpenAI/Gemini remain KB-only (no tool calling) -- see CLAUDE.md "Known
# limitations" before switching this away from claude in production.
LLM_PROVIDER=claude

# === Claude API ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# === OpenAI API (alternative) ===
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# === Gemini API (alternative) ===
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# === ElevenLabs TTS ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Selina uses the same voice as Kavya's Media Streams path (operator decision,
# Aug 2026) -- this is Kavya's Media Streams ElevenLabs voice ID.
ELEVENLABS_VOICE_ID=IHidXiNlNy77IIuhYr6a

# === STT (Media Streams / Dialog SmartPBX) ===
# "google" (default, uses GOOGLE_APPLICATION_CREDENTIALS) or "azure" (reuses
# AZURE_SPEECH_KEY / AZURE_SPEECH_REGION below). Mirrors Kavya's STT_PROVIDER
# knob and AzureSTTStream/GoogleSTTStream pair.
STT_PROVIDER=google
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# Barge-in echo gating -- Dialog SmartPBX has no echo cancellation, so without
# this Selina's own TTS leaking back into the mic gets misread as the caller
# interrupting, cutting her off mid-sentence. A result must be at least this
# many characters and arrive after this debounce (seconds) from when TTS
# started to count as a genuine interruption. Mirrors Kavya's same knobs.
BARGEIN_MIN_CHARS=12
BARGEIN_DEBOUNCE_SECONDS=0.6

# === Knowledge Base ===
KB_DOCS_DIRECTORY=knowledge_docs
# How many KB paragraphs are handed to the LLM per turn. Hutch has 30+ short
# plan paragraphs that share words like "unlimited"/"30 days", so too few
# chunks makes Selina miss the specific plan's price. Default 8; raise if she
# still misses plans, lower if turns get slow.
KB_N_RESULTS=8
# Shared secret for POST /kb-reload (Sentinel admin portal KB auto-structuring
# feature). Leave blank to disable hot-reload (default-deny).
KB_RELOAD_SECRET=

# === Server ===
PORT=8000

# === Dashboard (Sentinel admin portal) ===
DASHBOARD_API_URL=
DASHBOARD_API_KEY=
DASHBOARD_AGENT_ID=hutch

# === WhatsApp-notify handover (no live call transfer for Hutch) ===
N8N_BASE_URL=https://automation.taskforceai.tech
# Production handover workflow (built by the operator in n8n). The agent POSTs
# the handover payload here; the workflow WhatsApps the staff/operator.
# notify_human_handover stays fail-open: a failed POST never affects the call.
N8N_HANDOVER_WEBHOOK=/webhook/7eac5da8-8683-453e-8e50-d6bd79f27372
WHATSAPP_COUNTRY_CODE=94
# Staff/operator WhatsApp number the handover notification is sent to. The n8n
# workflow sends to whatever arrives in the payload's human_agent_whatsapp, so
# this MUST be set (the workflow does not hardcode a recipient). Accepts a local
# number -- the agent normalises it (0711754668 -> 94711754668).
HUTCH_HUMAN_AGENT_WHATSAPP=0711754668

# === Twilio (NOT USED -- Hutch has no Twilio number) ===
# Left blank deliberately. The Twilio-mode code path in server.py stays
# present (inert, unconfigured) for fleet consistency; do not populate these
# unless a deliberate future decision adds a Twilio number for this agent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# === Service mode ===
# "smartpbx" (default for Hutch -- no Twilio number exists) | "twilio"
HUTCH_SERVICE_MODE=smartpbx

# === Dialog SmartPBX ("Client Connect") ===
# The hutch-smartpbx Compose profile sets HUTCH_SERVICE_MODE=smartpbx and
# enables this boundary only in its container.
ENABLE_SMARTPBX_WSS=false
# TODO: generate with `openssl rand -hex 32`.
SMARTPBX_WS_TOKEN=
# TODO: from Dialog once the SmartPBX/Client Connect tenant is provisioned.
SMARTPBX_ACCOUNT_ID=
SMARTPBX_MAX_CALLS=4

# Bounded waits. The outbound frame queue paces audio at realtime, so it must
# be deep enough to hold a long reply; overflow cuts the tail of the reply.
SMARTPBX_MAX_MESSAGE_CHARS=65536
SMARTPBX_MAX_AUDIO_BYTES=32768
SMARTPBX_MAX_OUTBOUND_FRAMES=128
SMARTPBX_START_TIMEOUT_SECONDS=10
SMARTPBX_IDLE_TIMEOUT_SECONDS=90

# Dialog sends g711_ulaw audio at 8000 Hz. These are dashboard media
# settings, not application secrets, and must match the Dialog client
# configuration.
SMARTPBX_MEDIA_ENCODING=g711_ulaw
SMARTPBX_MEDIA_SAMPLE_RATE=8000
