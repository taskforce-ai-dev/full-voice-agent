[Unit]
Description=SmartPBX Factory Console (review-only private origin)
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=factory-console
Group=factory-console
WorkingDirectory=/var/lib/factory-console
EnvironmentFile=/etc/factory-console/console.env
ExecStartPre=/usr/local/libexec/factory-console verify-access-config --config /etc/factory-console/policy.json
ExecStart=/usr/local/libexec/factory-console serve --config /etc/factory-console/policy.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
UMask=0077

RuntimeDirectory=factory-console
RuntimeDirectoryMode=0750
StateDirectory=factory-console
StateDirectoryMode=0750
LogsDirectory=factory-console
LogsDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=no
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/factory-console /var/log/factory-console

[Install]
WantedBy=multi-user.target
