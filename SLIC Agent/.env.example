# =============================================================================
# SLIC Voice Agent (Nimali) — environment template
# Copy to .env and fill in your own values. Do NOT commit .env.
# =============================================================================

# === LLM Provider =============================================================
# Options: "claude" (default), "openai", "gemini"
LLM_PROVIDER=claude

# --- Anthropic Claude (default provider) -------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- OpenAI (alternative) ----------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# --- Gemini (alternative) ----------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# === ElevenLabs TTS ===========================================================
# Used by Twilio ConversationRelay (production) and by the local
# test_voice_elevenlabs.py smoke-test script.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here

# === Twilio (production telephony) ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# === SLIC-specific ============================================================
# How long a caller's active-session record lingers after an assessor has been
# dispatched. A return call within this window is treated as a continuation.
# Default: 1800 seconds (30 minutes).
SLIC_SESSION_TTL_SECONDS=1800

# === Post-Call Data Capture ===================================================
# After each call ends, the server posts extracted claim details + transcript
# to this n8n webhook (appended to a Google Sheet by the n8n workflow).
N8N_BASE_URL=https://automation.taskforceai.tech
N8N_POSTCALL_WEBHOOK=/webhook/slic-transcript

# === Knowledge Base ===========================================================
# Directory of text documents indexed into ChromaDB on startup.
KB_DOCS_DIRECTORY=knowledge_docs

# === Server ===================================================================
PORT=8000
