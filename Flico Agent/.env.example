# === LLM Provider ===
# Options: "claude" (default), "openai", "gemini"
LLM_PROVIDER=claude

# === Claude API ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# === OpenAI API ===
# Required: powers the Sinhala voice (gpt-4o-mini-tts). Also the LLM if
# LLM_PROVIDER=openai.
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# === Gemini API (alternative) ===
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# === ElevenLabs TTS (English ConversationRelay + Tamil Media Streams) ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here
ELEVENLABS_VOICE_SPEED=1.0

# === Azure Speech (Tamil TTS via Media Streams) ===
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia

# === Sinhala TTS (OpenAI gpt-4o-mini-tts via Media Streams) ===
# Sinhala voice runs on OPENAI_API_KEY above. Optional overrides:
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_TTS_INSTRUCTIONS=Speak in warm, friendly, natural conversational Sinhala...

# === Sinhala VITS TTS (legacy fallback only) ===
# Self-hosted Sinhala VITS service — no longer the active Sinhala path.
# Used only by the dormant _tts_sinhala fallback if revived.
SINHALA_TTS_URL=http://sinhala-tts:8000

# === Google Cloud STT (Media Streams) ===
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# === Twilio (production only) ===
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# === Knowledge Base ===
KB_DOCS_DIRECTORY=knowledge_docs

# === Server ===
PORT=8000

# === Asterisk SIP Pilot (disabled by default) ===
# Enables a background ARI worker that receives SIP calls from Asterisk and
# runs them through the Media Streams-style STT -> LLM -> TTS pipeline.
ENABLE_ASTERISK_ARI=false
ASTERISK_ARI_URL=http://flico-asterisk-pilot:8088/ari
ASTERISK_ARI_USER=flico_ari
ASTERISK_ARI_PASSWORD=change_me_to_match_asterisk_ari_conf
ASTERISK_APP_NAME=flico-sip-agent
ASTERISK_RTP_BIND_HOST=0.0.0.0
ASTERISK_RTP_ADVERTISE_HOST=flico-voice-agent
ASTERISK_RTP_PORT_START=18000
ASTERISK_RTP_PORT_END=18100
ASTERISK_DEFAULT_LANG=en

# === Dialog SmartPBX WSS (opt-in; no production credentials in this file) ===
# Keep disabled until every SMARTPBX_RUNBOOK.md operator gate has been completed.
ENABLE_SMARTPBX_WSS=false
SMARTPBX_WS_TOKEN=
SMARTPBX_ACCOUNT_ID=
SMARTPBX_MAX_CALLS=4
SMARTPBX_MAX_MESSAGE_CHARS=65536
SMARTPBX_MAX_AUDIO_BYTES=32768
SMARTPBX_MAX_OUTBOUND_FRAMES=128
SMARTPBX_START_TIMEOUT_SECONDS=10
SMARTPBX_IDLE_TIMEOUT_SECONDS=90
SMARTPBX_MCP_URL=https://dialog.cybergate.lk:9443/ucp/v2/mcp
SMARTPBX_API_KEY=
SMARTPBX_TRANSFER_DESTINATIONS_JSON={}
SMARTPBX_MCP_ACCOUNT_HEADER=
SMARTPBX_MCP_CONNECT_TIMEOUT_SECONDS=3
SMARTPBX_MCP_READ_TIMEOUT_SECONDS=8
SMARTPBX_MCP_RETRIES=1
