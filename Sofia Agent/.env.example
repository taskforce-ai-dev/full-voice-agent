# === LLM Provider ===
# Options: "claude" (default), "openai", "gemini"
LLM_PROVIDER=claude

# === Claude API ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# === OpenAI API (alternative) ===
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# === Gemini API (alternative) ===
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# === ElevenLabs TTS (English ConversationRelay + Tamil Media Streams) ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here

# === Azure Speech (Tamil TTS via Media Streams) ===
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia

# === Google Cloud STT (Media Streams) ===
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# === Twilio (production only) ===
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# === Knowledge Base ===
KB_DOCS_DIRECTORY=knowledge_docs

# === Server ===
PORT=8000
