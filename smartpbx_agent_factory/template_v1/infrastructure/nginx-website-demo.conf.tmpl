# REVIEW-ONLY website-demo ingress. Provision TLS separately before activation.
server {
    listen 443 ssl;
    server_name {{website_hostname}};

    ssl_certificate {{tls_certificate_path}};
    ssl_certificate_key {{tls_certificate_key_path}};

    location = /api/voice-token {
        proxy_pass http://127.0.0.1:{{website_port}};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /voice/demo-incoming {
        proxy_pass http://127.0.0.1:{{website_port}};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /ws/v1/website-demo/conversation {
        # The one-time admission ticket is in the query string; never persist it.
        access_log off;
        proxy_pass http://127.0.0.1:{{website_port}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health { return 404; }
    location / { return 404; }
}
