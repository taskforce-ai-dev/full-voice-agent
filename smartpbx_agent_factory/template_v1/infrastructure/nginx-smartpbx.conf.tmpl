# REVIEW-ONLY TLS proxy candidate. The only media ingress is the WSS route below.
server {
    listen 443 ssl;
    server_name {{smartpbx_hostname}};
    server_tokens off;

    # Certificate paths are supplied only by separately reviewed host configuration.
    ssl_certificate {{tls_certificate_path}};
    ssl_certificate_key {{tls_certificate_key_path}};
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /ws/v1/smartpbx/media {
        proxy_pass http://127.0.0.1:{{smartpbx_port}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header {{wss_header}} $http_x_smartpbx_token;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:{{smartpbx_port}};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The runtime validates X-SmartPBX-Token before returning status.
    location = /smartpbx/status {
        proxy_pass http://127.0.0.1:{{smartpbx_port}};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header {{wss_header}} $http_x_smartpbx_token;
    }

    location / { return 404; }
}
